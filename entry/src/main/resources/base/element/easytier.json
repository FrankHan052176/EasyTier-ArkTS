    },
    {
      "name": "latency_first_help",
      "value": "Ignore hop count and select the path with the lowest total latency"
    },
    {
      "name": "use_smoltcp",
      "value": "Use User-Space Protocol Stack"
    },
    {
      "name": "use_smoltcp_help",
      "value": "Use a user-space TCP/IP stack to avoid issues with operating system firewalls blocking subnet or KCP proxy functionality."
    },
    {
      "name": "disable_ipv6",
      "value": "Disable IPv6"
    },
    {
      "name": "disable_ipv6_help",
      "value": "Disable IPv6 functionality for this node, only use IPv4 for network communication."
    },
    {
      "name": "enable_kcp_proxy",
      "value": "Enable KCP Proxy"
    },
    {
      "name": "enable_kcp_proxy_help",
      "value": "Convert TCP traffic to KCP traffic to reduce latency and boost transmission speed."
    },
    {
      "name": "disable_kcp_input",
      "value": "Disable KCP Input"
    },
    {
      "name": "disable_kcp_input_help",
      "value": "Disable inbound KCP traffic, while nodes with KCP proxy enabled continue to connect using TCP."
    },
    {
      "name": "enable_quic_proxy",
      "value": "Enable QUIC Proxy"
    },
    {
      "name": "enable_quic_proxy_help",
      "value": "Convert TCP traffic to QUIC traffic to reduce latency and boost transmission speed."
    },
    {
      "name": "disable_quic_input",
      "value": "Disable QUIC Input"
    },
    {
      "name": "disable_quic_input_help",
      "value": "Disable inbound QUIC traffic, while nodes with QUIC proxy enabled continue to connect using TCP."
    },
    {
      "name": "disable_p2p",
      "value": "Disable P2P"
    },
    {
      "name": "disable_p2p_help",
      "value": "Disable P2P mode; route all traffic through a manually specified relay server."
    },
    {
      "name": "p2p_only",
      "value": "P2P Only"
    },
    {
      "name": "p2p_only_help",
      "value": "Only communicate with peers that have already established P2P connections, do not relay through other nodes."
    },
    {
      "name": "lazy_p2p",
      "value": "Lazy P2P"
    },
    {
      "name": "lazy_p2p_help",
      "value": "Only try to establish P2P when traffic actually targets a peer. Peers with need-p2p enabled are still connected proactively."
    },
    {
      "name": "bind_device",
      "value": "Bind to Physical Device Only"
    },
    {
      "name": "bind_device_help",
      "value": "Use only the physical network interface to prevent EasyTier from connecting via virtual networks."
    },
    {
      "name": "no_tun",
      "value": "No TUN Mode"
    },
    {
      "name": "no_tun_help",
      "value": "Do not use a TUN interface, suitable for environments without administrator privileges. This node is only accessible; accessing other nodes requires SOCKS5."
    },
    {
      "name": "enable_exit_node",
      "value": "Enable Exit Node"
    },
    {
      "name": "enable_exit_node_help",
      "value": "Allow this node to be an exit node"
    },
    {
      "name": "relay_all_peer_rpc",
      "value": "Relay RPC Packets"
    },
    {
      "name": "relay_all_peer_rpc_help",
      "value": "Relay all peer rpc packets, even if the peer is not in the relay network whitelist.\nThis can help peers not in relay network whitelist to establish p2p connection.\n"
    },
    {
      "name": "need_p2p",
      "value": "Need P2P"
    },
    {
      "name": "need_p2p_help",
      "value": "Ask other peers to proactively establish P2P connections to this node even when they enable lazy P2P."
    },
    {
      "name": "multi_thread",
      "value": "Multi Thread"
    },
    {
      "name": "multi_thread_help",
      "value": "Use multi-thread runtime"
    },
    {
      "name": "proxy_forward_by_system",
      "value": "System Forward"
    },
    {
      "name": "proxy_forward_by_system_help",
      "value": "Forward packet to proxy networks via system kernel, disable internal nat for network proxy"
    },
    {
      "name": "disable_encryption",
      "value": "Disable Encryption"
    },
    {
      "name": "disable_encryption_help",
      "value": "Disable encryption for peers communication. Encryption is enabled by default, this option must be same with peers."
    },
    {
      "name": "disable_tcp_hole_punching",
      "value": "Disable TCP Hole Punching"
    },
    {
      "name": "disable_tcp_hole_punching_help",
      "value": "Disable tcp hole punching"
    },
    {
      "name": "disable_udp_hole_punching",
      "value": "Disable UDP Hole Punching"
    },
    {
      "name": "disable_udp_hole_punching_help",
      "value": "Disable udp hole punching"
    },
    {
      "name": "disable_sym_hole_punching",
      "value": "Disable Symmetric NAT Hole Punching"
    },
    {
      "name": "disable_sym_hole_punching_help",
      "value": "Disable special hole punching handling for symmetric NAT (based on birthday attack), treat symmetric NAT as cone NAT"
    },
    {
      "name": "enable_magic_dns",
      "value": "Enable Magic DNS"
    },
    {
      "name": "enable_magic_dns_help",
      "value": "Enable magic dns, all nodes in the network can access each other by domain name, e.g.: node1.et.net.\n"
    },
    {
      "name": "enable_private_mode",
      "value": "Enable Private Mode"
    },
    {
      "name": "enable_private_mode_help",
      "value": "Enable private mode, nodes with different network names or passwords from this network are not allowed to perform handshake or relay through this node.\n"
    },
    {
      "name": "relay_network_whitelist",
      "value": "Network Whitelist"
    },
    {
      "name": "relay_network_whitelist_help",
      "value": "Only forward traffic from the whitelist networks, supporting wildcard strings, multiple network names can be separated by spaces.\nIf this parameter is empty, forwarding is disabled. By default, all networks are allowed.\ne.g.: '*' (all networks), 'def*' (networks with the prefix 'def'), 'net1 net2' (only allow net1 and net2)\n"
    },
    {
      "name": "manual_routes",
      "value": "Manual Route"
    },
    {
      "name": "manual_routes_help",
      "value": "Assign routes cidr manually, will disable subnet proxy and wireguard routes propagated from peers. e.g.:192.168.0.0/16\n"
    },
    {
      "name": "socks5",
      "value": "Socks5 Server"
    },
    {
      "name": "socks5_help",
      "value": "Enable socks5 server, allow socks5 client to access virtual network. format: <port>, e.g.: 1080\n"
    },
    {
      "name": "exit_nodes",
      "value": "Exit Nodes"
    },
    {
      "name": "exit_nodes_help",
      "value": "Exit nodes to forward all traffic to, a virtual ipv4 address, priority is determined by the order of the list"
    },
    {
      "name": "port_forwards",
      "value": "Port Forward"
    },
    {
      "name": "port_forwards_help",
      "value": "forward local port to remote port in virtual network. e.g.: udp://0.0.0.0:12345/10.126.126.1:23456, means forward local udp port 12345 to 10.126.126.1:23456 in the virtual network. can specify multiple."
    },
    {
      "name": "port_forwards_bind_addr",
      "value": "Bind address, e.g.: 0.0.0.0"
    },
    {
      "name": "port_forwards_dst_addr",
      "value": "Destination address, e.g.: 10.126.126.1"
    },
    {
      "name": "port_forwards_add_btn",
      "value": "Add"
    },
    {
      "name": "edit_port_forward",
      "value": "Edit Port Forward"
    },
    {
      "name": "mtu",
      "value": "MTU"
    },
    {
      "name": "mtu_help",
      "value": "MTU of the TUN device, default is 1380 for non-encryption, 1360 for encryption. Range:400-1380\n"
    },
    {
      "name": "mtu_placeholder",
      "value": "Leave blank as default value 1380"
    },
    {
      "name": "instance_recv_bps_limit",
      "value": "Instance Receive Limit"
    },
    {
      "name": "instance_recv_bps_limit_help",
